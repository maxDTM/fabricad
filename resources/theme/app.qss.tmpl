/* FabriCAD application stylesheet template (docs/plans/ui-redesign.md section 2.2).
   Hand-written; colours only through @{token} or @{alias} placeholders, optionally with an alpha
   percentage (@{surface.panel/92}). No raw colour literals and no fonts: ThemeManager sets the
   fonts per class and objectName (section 3). tools/theme/gen_tokens.py --check validates this file.
   Radii: 0 for containers, 1 px for inputs and chips. */
QMainWindow, QDialog { background: @{window.bg}; color: @{text.primary}; }
/* own windows get an edge: without window decorations (frameless, light theme on a light
   viewport) the dialog would dissolve into what is behind it (p1-check 9) */
QDialog#PreferencesDialog, QDialog#ParametersDialog, QMessageBox, QInputDialog { border: 1px solid @{border.control}; }
QToolTip { background: @{tooltip.bg}; color: @{text.primary}; border: 1px solid @{edge}; padding: 4px; }
QLabel { color: @{text.primary}; }
QLabel:disabled { color: @{text.disabled}; }

/* title bar (5.1): logo menu, workspace selector, angled document tabs (painted), search box */
#AppBar { background: @{bg.app}; border-bottom: 1px solid @{border.subtle}; }
#AppBar QToolButton { border: none; padding: 3px; border-radius: 1px; color: @{text.primary}; background: transparent; }
#AppBar QToolButton:hover { background: @{row.hover.bg}; }
#AppBar QToolButton::menu-indicator { image: none; width: 0; }
QToolButton#AppMenuButton { padding: 3px 6px; }
QToolButton#NewTabButton { color: @{text.secondary}; padding: 2px 8px; }
QToolButton#NewTabButton:hover { color: @{text.primary}; }
#WorkspaceSwitcher, #AppBar QToolButton#WorkspaceSwitcher { background: @{surface.header}; border: 1px solid @{border.default}; border-radius: 1px; padding: 0; min-height: 26px; max-height: 26px; }
#AppBar QToolButton#WorkspaceSwitcher:hover { border-color: @{accent.text}; background: @{surface.header}; }
#AppBar QToolButton#WorkspaceSwitcher:pressed, #AppBar QToolButton#WorkspaceSwitcher:open { background: @{accent.selFill}; }
QLabel#WorkspaceName { color: @{text.primary}; background: transparent; }
QLabel#WorkspaceArrow { color: @{text.secondary}; background: transparent; }
QLabel#Keycap { color: @{text.secondary}; background: @{surface.header}; border: 1px solid @{border.default}; border-radius: 1px; padding: 0 4px; }
#AppBar QToolButton#SearchBox { background: @{surface.input}; border: 1px solid @{border.default}; border-radius: 1px; padding: 0; }
#AppBar QToolButton#SearchBox:hover { border-color: @{accent.text}; background: @{surface.input}; }
QLabel#SearchGlyph { color: @{accent.text}; background: transparent; }
QLabel#SearchBoxText { color: @{text.tertiary}; background: transparent; }
QTabBar#DocumentTabs { background: transparent; }
QTabBar#DocumentTabs::tab { color: @{text.secondary}; background: transparent; border: none; padding: 0 16px 0 18px; margin: 0; min-width: 120px; height: 36px; }
QTabBar#DocumentTabs::tab:selected { color: @{text.primary}; background: @{panel.bg}; border-top: 2px solid @{tab.active.indicator}; }
QTabBar#DocumentTabs::close-button { image: url(:/ui/@{theme}/tab-close.svg); subcontrol-position: right; margin: 0 10px 0 2px; width: 14px; height: 14px; }
QTabBar#DocumentTabs::close-button:hover { background: @{surface.pressed}; border-radius: 1px; }
#DocumentTabModified { color: @{doc.unsavedDot}; background: transparent; }

/* main toolbar (5.1): straight 1 px section dividers, captions below the buttons */
QToolBar#MainToolbarHost { background: @{panel.bg}; border: none; border-bottom: 1px solid @{border.default}; padding: 0; margin: 0; spacing: 0; }
#RibbonRow { background: @{panel.bg}; }
#RibbonGroup { border-right: 1px solid @{border.default}; background: transparent; }
#RibbonGroup[document="true"] { border-right: none; border-left: 1px solid @{border.default}; }
#RibbonGroup[finish="true"] { border-right: none; }
QToolButton#RibbonTool { border: 1px solid transparent; border-radius: 1px; padding: 2px 4px; background: transparent; color: @{text.primary}; }
QToolButton#RibbonTool:hover { background: @{row.hover.bg}; }
QToolButton#RibbonTool:pressed { background: @{button.pressed.bg}; }
QToolButton#RibbonTool:checked { background: @{tool.checked.bg}; border-color: @{tool.checked.border}; }
QToolButton#RibbonTool:disabled { color: @{text.disabled}; }
QToolButton#RibbonTool::menu-indicator { image: url(:/ui/@{theme}/arrow-down.svg); subcontrol-position: top right; subcontrol-origin: padding; width: 8px; height: 8px; top: 4px; }
QToolButton#RibbonGroupLabel { border: none; border-top: 1px solid @{border.subtle}; color: @{text.secondary}; padding: 0 4px; background: transparent; }
QToolButton#RibbonGroupLabel:hover { color: @{accent.text}; }
QToolButton#RibbonGroupLabel:pressed, QToolButton#RibbonGroupLabel:open { background: @{accent.selFill}; color: @{accent.text}; }
QToolButton#RibbonGroupLabel::menu-indicator { image: none; width: 0; }
/* collapsed section: icon button over the usual caption (same baseline as the others, p1-check 6) */
QToolButton#RibbonCollapsedTool { border: 1px solid transparent; border-radius: 1px; padding: 2px 4px; background: transparent; }
QToolButton#RibbonCollapsedTool:hover { background: @{row.hover.bg}; }
QToolButton#RibbonCollapsedTool:pressed, QToolButton#RibbonCollapsedTool:open { background: @{accent.selFill}; }
QToolButton#RibbonCollapsedTool::menu-indicator { image: url(:/ui/@{theme}/arrow-down.svg); subcontrol-position: bottom right; subcontrol-origin: padding; width: 8px; height: 8px; }
#RibbonGroup[collapsed="true"] QToolButton#RibbonGroupLabel { color: @{text.primary}; }
QToolButton#FinishSketchButton { background: @{button.finish.bg}; color: @{button.finish.text}; border-radius: 1px; padding: 6px 12px; border: none; }
QToolButton#FinishSketchButton:hover { background: @{button.finish.bg/85}; }
/* vertical toolbar (ui/toolbarArea left / right, 5.1): caption bars with a straight rule above */
QToolBar#MainToolbarHost[area="left"] { border-bottom: none; border-right: 1px solid @{border.default}; }
QToolBar#MainToolbarHost[area="right"] { border-bottom: none; border-left: 1px solid @{border.default}; }
#RibbonGroup[vertical="true"], #RibbonGroup[vertical="true"][document="true"] { border: none; }
QToolButton#RibbonGroupLabel[vertical="true"] { border-top: 1px solid @{border.default}; padding: 0 2px; text-align: left; }
QToolButton#RibbonTool[vertical="true"] { padding: 1px 2px; }
QToolButton#FinishSketchButton[vertical="true"] { padding: 2px; }
/* floating quick toolbar in the viewport (ui/quickToolbar, 5.3) */
#QuickToolbar { background: @{surface.overlay/92}; border: 1px solid @{edge}; border-radius: 0; }
#QuickToolbar QToolButton { border: 1px solid transparent; border-radius: 1px; padding: 3px; background: transparent; }
#QuickToolbar QToolButton:hover { background: @{row.hover.bg}; }
#QuickToolbar QToolButton:pressed { background: @{button.pressed.bg}; }
#QuickToolbar QToolButton:checked { background: @{tool.checked.bg}; border-color: @{tool.checked.border}; }
#QuickToolbar QToolButton:disabled { color: @{text.disabled}; }
#QuickToolbar QToolButton#FinishSketchButton { background: @{button.finish.bg}; color: @{button.finish.text}; }
#QuickToolbarSeparator { color: @{edge}; }

QMenu { background: @{popup.bg}; color: @{text.primary}; border: 1px solid @{edge}; padding: 4px 0; }
QMenu::item { color: @{text.primary}; background: transparent; padding: 4px 28px 4px 26px; }
QMenu::item:selected { background: @{row.selected.bg}; color: @{row.selected.text}; }
QMenu::item:disabled { color: @{text.disabled}; background: transparent; }
QMenu::separator { height: 1px; background: @{divider}; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:non-exclusive:unchecked { image: none; }
QMenu::indicator:non-exclusive:checked, QMenu::indicator:exclusive:checked { image: url(:/ui/@{theme}/menu-check.svg); }
QMenu::right-arrow { image: url(:/ui/@{theme}/arrow-right.svg); width: 10px; height: 10px; }
QLabel#MenuHeader, QLabel#MenuHeader:disabled { color: @{text.secondary}; padding: 4px 12px 2px 12px; background: transparent; }

/* browser */
QDockWidget { color: @{text.primary}; }
QDockWidget::title { background: @{panel.header.bg}; padding: 4px 8px; border-bottom: 1px solid @{edge}; }
QTreeWidget#Browser { background: @{panel.bg}; border: none; color: @{text.primary}; }
QTreeWidget#Browser::item { padding: 0; color: @{text.primary}; background: transparent; }
QTreeWidget#Browser::item:hover, QTreeWidget#Browser::item:selected { background: transparent; color: @{row.selected.text}; }
QTreeWidget#Browser::branch { background: transparent; }
QListWidget { background: @{panel.bg}; color: @{text.primary}; border: none; }
QListWidget::item:selected { background: @{row.selected.bg}; color: @{row.selected.text}; }

/* sidebar (phase 2): host, panels, splitter, card slot; headers and rows are painted from tokens */
QDockWidget#BrowserDock { border: none; }
#SidebarHost, #FeaturesBody, #FeatureStack, #ModelStack, #CardSlot, #SelectionPanel { background: @{panel.bg}; }
QDockWidget#BrowserDock[side="left"] #SidebarHost { border-right: 1px solid @{edge}; }
QDockWidget#BrowserDock[side="right"] #SidebarHost { border-left: 1px solid @{edge}; }
#SidebarSplitter::handle { background: @{panel.bg}; }
#SidebarSplitter::handle:vertical { height: 6px; border-top: 1px solid @{divider}; }
#SidebarSplitter::handle:hover { border-top: 1px solid @{accent.indicator}; }
#PanelHeader QToolButton { border: none; padding: 3px; border-radius: 1px; background: transparent; }
#PanelHeader QToolButton:hover { background: @{row.hover.bg}; }
#PanelHeader QToolButton:checked { background: @{row.selected.bg}; }
#PanelHeader QToolButton::menu-indicator { image: none; width: 0; }
#PanelHeader QToolButton:focus { border: 2px solid @{accent.focus}; }
QLineEdit#FeatureSearch { min-height: 24px; }
QLineEdit#FeatureListRename { border: 2px solid @{accent.focus}; padding: 0 4px; }
#FeatureList, #FeatureListViewport { background: @{panel.bg}; border: none; }

/* timeline */
#Timeline { background: @{panel.bg}; border-top: 1px solid @{edge}; }
#Timeline QToolButton { border: none; padding: 2px; border-radius: 1px; }
#Timeline QToolButton:hover { background: @{row.hover.bg}; }
#TimelineScroll, #TimelineViewport, #TimelineStrip { background: transparent; }

/* command dialog */
#CommandDialog { background: @{popup.bg}; border: 1px solid @{edge}; border-radius: 0; }
#CommandDialogTitle { background: @{panel.header.bg}; border-bottom: 1px solid @{edge}; }
#CommandDialogTitle QLabel { color: @{text.primary}; }
#CommandDialogMessage { color: @{text.secondary}; }
#CommandDialogMessage[error="true"] { color: @{message.error}; }
/* command card (5.3, 5.4, 7.1): CardFrame paints the panel, brackets and hairline; QSS styles the controls */
#CommandDialog[card="true"] { background: transparent; border: none; }
#CommandDialog[card="true"] #CommandDialogTitle { background: transparent; border: none; }
#CommandDialog[card="true"] #CardSteps, #CommandDialog[card="true"] #CardFooter { background: transparent; }
QLabel#CardContext, QLabel#CardDocName { color: @{text.tertiary}; }
#CardBody QLabel { color: @{text.secondary}; }
#CardBody QLabel#SegmentedLabel { color: @{text.secondary}; }
#CardBody QLineEdit, #CardBody QComboBox, #CardBody QSpinBox, #CardBody QDoubleSpinBox { min-height: 24px; background: @{surface.input}; border: 1px solid @{border.control}; padding: 1px 6px; }
#CardBody QLineEdit:focus { border: 2px solid @{live.base}; padding: 0 5px; }
#CardBody QComboBox:focus, #CardBody QSpinBox:focus, #CardBody QDoubleSpinBox:focus { border-color: @{accent.focus}; }
#CardBody QComboBox { padding-right: 28px; }
#CardBody QComboBox::drop-down { width: 24px; border-left: 1px solid @{border.control}; }
QPushButton[selectionInput="true"] { background: @{surface.input}; border: 1px solid @{border.control}; border-radius: 1px; color: @{text.primary}; text-align: left; padding: 5px 8px; }
QPushButton[selectionInput="true"]:hover { border-color: @{accent.text}; background: @{surface.input}; }
QPushButton[selectionInput="true"]:checked { background: @{accent.selFill}; border-color: @{accent.indicator}; color: @{text.primary}; }
QPushButton[selectionInput="true"]:focus { border-color: @{accent.focus}; }
QPushButton#CancelButton { background: transparent; border: 1px solid @{border.control}; padding: 0; }
QPushButton#CancelButton:hover { background: @{surface.hover}; border-color: @{accent.text}; }
QPushButton#CancelButton:focus, QPushButton#OkButton:focus { border: 2px solid @{accent.focus}; }
#CardFooter QPushButton#OkButton { padding: 0; }
#CardFooter QPushButton#OkButton:disabled { background: @{surface.pressed}; border-color: @{surface.pressed}; }
QLabel#CardButtonText { background: transparent; }
QLabel#CardButtonText[primary="true"] { color: @{accent.onSolid}; }
QLabel#Keycap[primary="true"] { color: @{accent.onSolid}; background: @{accent.pressed}; border-color: @{accent.pressed}; }
QLabel#CardButtonText:disabled, QLabel#Keycap[primary="true"]:disabled { color: @{text.disabled}; background: transparent; border-color: @{border.default}; }
QPushButton { background: @{button.bg}; border: 1px solid @{button.border}; border-radius: 1px; padding: 4px 14px; color: @{text.primary}; }
QPushButton:hover { background: @{button.hover.bg}; border-color: @{accent.text}; }
QPushButton:pressed { background: @{button.pressed.bg}; }
QPushButton:focus { border-color: @{input.border.focus}; }
QPushButton:disabled { color: @{text.disabled}; border-color: @{edge}; background: @{panel.bg}; }
QPushButton#OkButton, QPushButton:default { background: @{button.primary.bg}; border-color: @{button.primary.bg}; color: @{button.primary.text}; }
QPushButton#OkButton:hover, QPushButton:default:hover { background: @{button.primary.hover}; border-color: @{button.primary.hover}; }
QPushButton#OkButton:pressed, QPushButton:default:pressed { background: @{button.primary.pressed}; }
QPushButton#OkButton:focus, QPushButton:default:focus { border-color: @{accent.focus}; }
QPushButton#OkButton:disabled { background: @{surface.pressed}; border-color: @{surface.pressed}; color: @{text.disabled}; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit { background: @{input.bg}; color: @{text.primary}; border: 1px solid @{input.border}; border-radius: 1px; padding: 2px 4px; selection-background-color: @{accent.solid}; selection-color: @{accent.onSolid}; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background: @{panel.bg}; color: @{text.disabled}; border-color: @{divider}; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: @{input.border.focus}; }
QComboBox { padding-right: 18px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 16px; border: none; border-left: 1px solid @{divider}; }
QComboBox::down-arrow { image: url(:/ui/@{theme}/arrow-down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background: @{tooltip.bg}; color: @{text.primary}; border: 1px solid @{input.border}; outline: 0; selection-background-color: @{row.selected.bg}; selection-color: @{row.selected.text}; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 14px; border: none; border-left: 1px solid @{divider}; background: @{panel.header.bg}; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 14px; border: none; border-left: 1px solid @{divider}; background: @{panel.header.bg}; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/ui/@{theme}/arrow-up.svg); width: 8px; height: 8px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/ui/@{theme}/arrow-down.svg); width: 8px; height: 8px; }

/* check boxes and radio buttons */
QCheckBox, QRadioButton { color: @{text.primary}; spacing: 6px; background: transparent; }
QCheckBox:disabled, QRadioButton:disabled { color: @{text.disabled}; }
QCheckBox::indicator, QRadioButton::indicator { width: 13px; height: 13px; background: @{input.bg}; border: 1px solid @{input.border}; }
QCheckBox::indicator { border-radius: 1px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @{accent.text}; }
QCheckBox::indicator:focus, QRadioButton::indicator:focus { border-color: @{accent.focus}; }
QCheckBox::indicator:checked { background: @{accent.solid}; border-color: @{accent.solid}; image: url(:/ui/@{theme}/check.svg); }
QCheckBox::indicator:indeterminate { background: @{accent.selFill}; border-color: @{accent.indicator}; }
QRadioButton::indicator:checked { background: @{accent.solid}; border-color: @{accent.solid}; image: url(:/ui/@{theme}/radio-dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: @{panel.bg}; border-color: @{divider}; }
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled { background: @{surface.pressed}; border-color: @{surface.pressed}; }

/* item views, tables, headers */
QTableView, QTreeView, QListView { background: @{panel.bg}; alternate-background-color: @{panel.header.bg}; color: @{text.primary}; gridline-color: @{divider}; selection-background-color: @{row.selected.bg}; selection-color: @{row.selected.text}; }
QTableView:disabled, QTreeView:disabled, QListView:disabled { color: @{text.disabled}; }
QHeaderView { background: @{panel.header.bg}; }
QHeaderView::section { background: @{panel.header.bg}; color: @{text.secondary}; padding: 3px 6px; border: none; border-right: 1px solid @{divider}; border-bottom: 1px solid @{edge}; }
QTableCornerButton::section { background: @{panel.header.bg}; border: none; border-bottom: 1px solid @{edge}; }

/* generic tabs (dialogs, property panes) */
QTabWidget::pane { border: 1px solid @{edge}; background: @{panel.bg}; top: -1px; }
QTabBar::tab { background: @{bg.app}; color: @{text.secondary}; padding: 4px 12px; border: 1px solid @{edge}; border-bottom: none; }
QTabBar::tab:selected { background: @{panel.bg}; color: @{text.primary}; }
QTabBar::tab:hover:!selected { color: @{text.primary}; background: @{row.hover.bg}; }
QTabBar QToolButton { background: @{panel.header.bg}; border: 1px solid @{edge}; color: @{text.primary}; }
QTabBar QToolButton::left-arrow { image: url(:/icons/timeline-prev.svg); }
QTabBar QToolButton::right-arrow { image: url(:/icons/timeline-next.svg); }
QTabBar::tear { width: 0; border: none; }

/* scroll bars */
QScrollBar:vertical { background: @{panel.bg}; width: 10px; margin: 0; border: none; }
QScrollBar:horizontal { background: @{panel.bg}; height: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: @{scrollbar.handle}; min-height: 24px; border-radius: 0; margin: 1px; }
QScrollBar::handle:horizontal { background: @{scrollbar.handle}; min-width: 24px; border-radius: 0; margin: 1px; }
QScrollBar::handle:hover { background: @{scrollbar.handle.hover}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* text areas, groups, progress */
QPlainTextEdit, QTextEdit, QTextBrowser { background: @{input.bg}; color: @{text.primary}; border: 1px solid @{edge}; selection-background-color: @{accent.solid}; selection-color: @{accent.onSolid}; }
QGroupBox { color: @{text.primary}; border: 1px solid @{edge}; border-radius: 0; margin-top: 8px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; color: @{text.secondary}; }
QProgressBar { background: @{input.bg}; color: @{text.primary}; border: 1px solid @{input.border}; border-radius: 1px; text-align: center; }
QProgressBar::chunk { background: @{accent.solid}; border-radius: 0; }
QScrollArea#CommandDialogScroll { background: transparent; border: none; }
QScrollArea#CommandDialogScroll > QWidget > QWidget { background: transparent; }
QDialogButtonBox QPushButton { min-width: 64px; }
QLineEdit[invalid="true"] { border-color: @{status.error}; background: @{status.errorFill}; }
QToolButton#SelectionInput { border: 1px solid @{input.border}; border-radius: 1px; padding: 2px 6px; background: @{input.bg}; color: @{text.primary}; text-align: left; }
QToolButton#SelectionInput:checked { border-color: @{accent.indicator}; background: @{accent.selFill}; }
QLabel[messageLevel="error"] { color: @{message.error}; }
QLabel[messageLevel="warning"] { color: @{message.warning}; }
QLabel[messageLevel="info"] { color: @{message.info}; }
QLabel[sketchState="conflict"] { color: @{sk.conflict}; }
QLabel[sketchState="full"] { color: @{text.primary}; }
QLabel[sketchState="free"] { color: @{sk.free}; }
QLabel#ParametersError { color: @{message.error}; }

/* viewport overlays */
#NavBar { background: @{surface.overlay/90}; border: 1px solid @{edge}; border-radius: 0; }
#NavBar QToolButton { border: none; padding: 3px; border-radius: 1px; }
#NavBar QToolButton:hover { background: @{row.hover.bg}; }
#NavBar QToolButton:checked { background: @{tool.checked.bg}; }
#NavBarSeparator { color: @{edge}; }
QLabel#DrawingUnavailable { background: @{panel.bg}; color: @{text.secondary}; }

/* S-box */
#SearchPopup { background: @{popup.bg}; border: 1px solid @{input.border}; border-radius: 0; }
#SearchPopup QTreeWidget { border: none; background: @{popup.bg}; }
#SearchPopup QTreeWidget::item:selected { background: @{row.selected.bg}; color: @{row.selected.text}; }

/* status bar / command line (5.1): cells divided by 1 px border.subtle */
QStatusBar { background: @{bg.app}; border-top: 1px solid @{border.subtle}; color: @{text.primary}; }
QStatusBar::item { border: none; border-left: 1px solid @{border.subtle}; }
QStatusBar QLabel { color: @{text.primary}; padding: 0 8px; }
#StatusPrompt { color: @{text.primary}; }
#StatusMessage { color: @{text.secondary}; }
#StatusDim { color: @{text.tertiary}; }
QLabel#StatusCell { color: @{text.tertiary}; padding: 0; }
QLabel#StatusValue { color: @{text.primary}; padding: 0; }
#StatusCellBox[on="true"] QLabel#StatusCell { color: @{accent.text}; }
#StatusCellBox[on="false"] QLabel#StatusValue { color: @{text.tertiary}; }
#CommandLineBox { background: @{surface.input}; border: 1px solid @{border.default}; border-radius: 1px; }
#CommandLineBox[focused="true"] { border-color: @{accent.focus}; }
QLabel#CommandLinePrompt { color: @{accent.text}; padding: 0 0 0 6px; background: transparent; }
#CommandLineBox QLineEdit#CommandLine { background: transparent; border: none; padding: 0 4px; min-width: 80px; }
QToolButton#CommandLineHistory { color: @{text.tertiary}; border: none; background: transparent; padding: 0 6px; }
QToolButton#CommandLineHistory:hover, QToolButton#CommandLineHistory[open="true"] { color: @{accent.text}; }
/* command history overlay (p1-check 2): header band clearly apart from the text below (5.2) */
#CommandHistoryPanel { background: @{surface.panel}; border: 1px solid @{border.control}; }
#CommandHistoryHeader { background: @{surface.header}; border-bottom: 1px solid @{border.default}; }
QLabel#CommandHistoryTitle { color: @{text.primary}; padding: 0; background: transparent; }
#CommandHistoryHeader QToolButton { color: @{text.secondary}; border: none; background: transparent; padding: 1px 6px; }
#CommandHistoryHeader QToolButton:hover { color: @{accent.text}; background: @{surface.hover}; }
QPlainTextEdit#CommandHistory { background: @{surface.panel}; border: none; color: @{text.primary}; padding: 2px 4px; }
#CommandLine { min-width: 80px; }

/* preferences */
#LayoutPreview { border: 1px solid @{border.default}; }
