/* FabriCAD light theme (tokens from docs/research/ux.md section 12). */
QMainWindow, QDialog { background: #F2F3F5; color: #2B2E33; }
QWidget { font-size: 9pt; }
QToolTip { background: #FFFFFF; color: #2B2E33; border: 1px solid #D3D6DB; padding: 4px; font-size: 9pt; font-weight: 400; }
QLabel { color: #2B2E33; }
QLabel:disabled { color: #A9AEB5; }

/* application bar */
#AppBar { background: #FFFFFF; border-bottom: 1px solid #D3D6DB; }
#AppBar QToolButton { border: none; padding: 3px; border-radius: 3px; }
#AppBar QToolButton:hover { background: #E8EEF4; }
QTabBar#DocumentTabs { background: transparent; }
QTabBar#DocumentTabs::tab { color: #6B7079; background: #F2F3F5; padding: 5px 6px 5px 12px; border: 1px solid #D3D6DB; border-bottom: none; border-top: 2px solid transparent; margin-right: 2px; min-width: 60px; }
QTabBar#DocumentTabs::tab:selected { color: #2B2E33; background: #FFFFFF; border-top: 2px solid #0696D7; }
QTabBar#DocumentTabs::tab:hover:!selected { color: #2B2E33; background: #E8EEF4; }
QTabBar#DocumentTabs::close-button { image: url(:/ui/tab-close.svg); subcontrol-position: right; margin: 0 2px 0 6px; width: 14px; height: 14px; }
QTabBar#DocumentTabs::close-button:hover { background: #E1E4E8; border-radius: 2px; }

/* workspace switcher + ribbon */
#RibbonRow { background: #F7F7F8; border-bottom: 1px solid #D3D6DB; }
#WorkspaceSwitcher { font-weight: 700; color: #2B2E33; border: 1px solid #D3D6DB; border-radius: 3px; padding: 4px 8px; background: #FFFFFF; margin: 4px; }
#WorkspaceSwitcher:hover { border-color: #0696D7; }
#RibbonTabs QTabBar { font-weight: 600; font-size: 8pt; }
#RibbonTabs QTabBar::tab { background: transparent; color: #6B7079; padding: 4px 12px; border: none; border-bottom: 2px solid transparent; font-weight: 600; font-size: 8pt; }
#RibbonTabs QTabBar::tab:selected { color: #2B2E33; border-bottom: 2px solid #0696D7; }
#RibbonTabs QTabBar::tab:hover { color: #2B2E33; }
#RibbonGroup { border-right: 1px solid #E1E4E8; }
QToolButton#RibbonTool { border: 1px solid transparent; border-radius: 3px; padding: 2px; background: transparent; }
QToolButton#RibbonTool:hover { background: #E8EEF4; border-color: #C9D7E6; }
QToolButton#RibbonTool:pressed, QToolButton#RibbonTool:checked { background: #D3E6F5; }
QToolButton#RibbonTool:disabled { color: #A9AEB5; }
QToolButton#RibbonGroupLabel { border: none; color: #2B2E33; font-size: 7.5pt; font-weight: 600; padding: 0 4px 2px 4px; }
QToolButton#RibbonGroupLabel:hover { color: #0696D7; }
QToolButton#RibbonGroupLabel::menu-indicator { subcontrol-position: right center; }
QToolButton#FinishSketchButton { background: #3BA55C; color: white; font-weight: 700; border-radius: 3px; padding: 4px 10px; border: none; }
QToolButton#FinishSketchButton:hover { background: #33914F; }

QMenu { background: #FFFFFF; color: #2B2E33; border: 1px solid #D3D6DB; padding: 4px 0; }
QMenu::item { color: #2B2E33; background: transparent; padding: 4px 28px 4px 26px; }
QMenu::item:selected { background: #E3F1FA; color: #2B2E33; }
QMenu::item:disabled { color: #A9AEB5; background: transparent; }
QMenu::separator { height: 1px; background: #E1E4E8; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:non-exclusive:unchecked { image: none; }
QMenu::indicator:non-exclusive:checked, QMenu::indicator:exclusive:checked { image: url(:/ui/menu-check.svg); }
QMenu::right-arrow { image: url(:/ui/arrow-right.svg); width: 10px; height: 10px; }
QLabel#MenuHeader, QLabel#MenuHeader:disabled { color: #6B7079; font-weight: 700; font-size: 8pt; padding: 4px 12px 2px 12px; background: transparent; }

/* browser */
QDockWidget { color: #2B2E33; font-weight: 600; }
QDockWidget::title { background: #F7F7F8; padding: 4px 8px; border-bottom: 1px solid #D3D6DB; }
QTreeWidget#Browser { background: #FFFFFF; border: none; }
QListWidget { background: #FFFFFF; color: #2B2E33; border: none; }
QListWidget::item:selected { background: #D3E6F5; color: #2B2E33; }
QTreeWidget#Browser { color: #2B2E33; }
QTreeWidget#Browser::item { padding: 2px 0; color: #2B2E33; }
QTreeWidget#Browser::item:hover { background: #EEF5FB; }
QTreeWidget#Browser::item:selected { background: #D3E6F5; color: #2B2E33; }

/* timeline */
#Timeline { background: #F7F7F8; border-top: 1px solid #D3D6DB; }
#Timeline QToolButton { border: none; padding: 2px; border-radius: 3px; }
#Timeline QToolButton:hover { background: #E8EEF4; }

/* command dialog */
#CommandDialog { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 4px; }
#CommandDialogTitle { background: #F7F7F8; border-bottom: 1px solid #D3D6DB; border-top-left-radius: 4px; border-top-right-radius: 4px; }
#CommandDialogTitle QLabel { font-weight: 700; color: #2B2E33; }
#CommandDialogMessage { color: #6B7079; }
#CommandDialogMessage[error="true"] { color: #D93025; }
QPushButton { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 3px; padding: 4px 14px; color: #2B2E33; }
QPushButton:hover { border-color: #0696D7; }
QPushButton:disabled { color: #A9AEB5; border-color: #D3D6DB; background: #F7F7F8; }
QPushButton#OkButton, QPushButton:default { background: #0696D7; border-color: #0696D7; color: #FFFFFF; font-weight: 600; }
QPushButton#OkButton:disabled { background: #9CCDE6; border-color: #9CCDE6; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit { background: #FFFFFF; color: #2B2E33; border: 1px solid #C3C8CF; border-radius: 3px; padding: 2px 4px; selection-background-color: #0696D7; selection-color: #FFFFFF; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background: #F7F7F8; color: #A9AEB5; border-color: #D3D6DB; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #0696D7; }
QComboBox { padding-right: 18px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 16px; border: none; border-left: 1px solid #E1E4E8; }
QComboBox::down-arrow { image: url(:/ui/arrow-down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background: #FFFFFF; color: #2B2E33; border: 1px solid #C3C8CF; outline: 0; selection-background-color: #E3F1FA; selection-color: #2B2E33; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 14px; border: none; border-left: 1px solid #E1E4E8; background: #F7F7F8; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 14px; border: none; border-left: 1px solid #E1E4E8; background: #F7F7F8; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/ui/arrow-up.svg); width: 8px; height: 8px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/ui/arrow-down.svg); width: 8px; height: 8px; }

/* check boxes and radio buttons */
QCheckBox, QRadioButton { color: #2B2E33; spacing: 6px; background: transparent; }
QCheckBox:disabled, QRadioButton:disabled { color: #A9AEB5; }
QCheckBox::indicator, QRadioButton::indicator { width: 13px; height: 13px; background: #FFFFFF; border: 1px solid #8A9099; }
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #0696D7; }
QCheckBox::indicator:checked { background: #0696D7; border-color: #0696D7; image: url(:/ui/check.svg); }
QCheckBox::indicator:indeterminate { background: #9CCDE6; border-color: #0696D7; }
QRadioButton::indicator:checked { background: #0696D7; border-color: #0696D7; image: url(:/ui/radio-dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: #F2F3F5; border-color: #D3D6DB; }
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled { background: #C3C8CF; border-color: #C3C8CF; }

/* item views, tables, headers */
QTableView, QTreeView, QListView { background: #FFFFFF; alternate-background-color: #F7F7F8; color: #2B2E33; gridline-color: #E1E4E8; selection-background-color: #D3E6F5; selection-color: #2B2E33; }
QTableView:disabled, QTreeView:disabled, QListView:disabled { color: #A9AEB5; }
QHeaderView { background: #F7F7F8; }
QHeaderView::section { background: #F7F7F8; color: #2B2E33; font-weight: 600; padding: 3px 6px; border: none; border-right: 1px solid #E1E4E8; border-bottom: 1px solid #D3D6DB; }
QTableCornerButton::section { background: #F7F7F8; border: none; border-bottom: 1px solid #D3D6DB; }

/* generic tabs (dialogs, property panes) */
QTabWidget::pane { border: 1px solid #D3D6DB; background: #FFFFFF; top: -1px; }
QTabBar::tab { background: #F2F3F5; color: #6B7079; padding: 4px 12px; border: 1px solid #D3D6DB; border-bottom: none; }
QTabBar::tab:selected { background: #FFFFFF; color: #2B2E33; }
QTabBar::tab:hover:!selected { color: #2B2E33; background: #E8EEF4; }
QTabBar QToolButton { background: #F7F7F8; border: 1px solid #D3D6DB; color: #2B2E33; }
QTabBar QToolButton::left-arrow { image: url(:/icons/timeline-prev.svg); }
QTabBar QToolButton::right-arrow { image: url(:/icons/timeline-next.svg); }
QTabBar::tear { width: 0; border: none; }

/* scroll bars */
QScrollBar:vertical { background: #F2F3F5; width: 10px; margin: 0; border: none; }
QScrollBar:horizontal { background: #F2F3F5; height: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #C3C8CF; min-height: 24px; border-radius: 4px; margin: 1px; }
QScrollBar::handle:horizontal { background: #C3C8CF; min-width: 24px; border-radius: 4px; margin: 1px; }
QScrollBar::handle:hover { background: #8A9099; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* text areas, groups, progress */
QPlainTextEdit, QTextEdit, QTextBrowser { background: #FFFFFF; color: #2B2E33; border: 1px solid #D3D6DB; selection-background-color: #0696D7; selection-color: #FFFFFF; }
QGroupBox { color: #2B2E33; border: 1px solid #D3D6DB; border-radius: 3px; margin-top: 8px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; font-weight: 600; }
QProgressBar { background: #FFFFFF; color: #2B2E33; border: 1px solid #C3C8CF; border-radius: 3px; text-align: center; }
QProgressBar::chunk { background: #0696D7; border-radius: 2px; }
QScrollArea#CommandDialogScroll { background: transparent; border: none; }
QScrollArea#CommandDialogScroll > QWidget > QWidget { background: transparent; }
QDialogButtonBox QPushButton { min-width: 64px; }
QLineEdit[invalid="true"] { border-color: #D93025; background: #FFF4F3; }
QToolButton#SelectionInput { border: 1px solid #C3C8CF; border-radius: 3px; padding: 2px 6px; background: #FFFFFF; text-align: left; }
QToolButton#SelectionInput:checked { border-color: #0696D7; background: #E3F1FA; }

/* viewport overlays */
#NavBar { background: rgba(255,255,255,230); border: 1px solid #D3D6DB; border-radius: 4px; }
#NavBar QToolButton { border: none; padding: 3px; border-radius: 3px; }
#NavBar QToolButton:hover { background: #E8EEF4; }
#NavBar QToolButton:checked { background: #D3E6F5; }

/* S-box */
#SearchPopup { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 4px; }
#SearchPopup QTreeWidget { border: none; }
#SearchPopup QTreeWidget::item:selected { background: #E3F1FA; color: #2B2E33; }

/* status bar / command line */
QStatusBar { background: #F7F7F8; border-top: 1px solid #D3D6DB; color: #2B2E33; }
QStatusBar QLabel { color: #2B2E33; padding: 0 6px; }
#StatusPrompt { color: #2B2E33; }
#StatusDim { color: #6B7079; }
#CommandLine { font-family: monospace; min-width: 260px; }
