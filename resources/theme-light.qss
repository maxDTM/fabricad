/* FabriCAD light theme (tokens from docs/research/ux.md section 12). */
QMainWindow, QDialog { background: #F2F3F5; color: #2B2E33; }
QWidget { font-size: 9pt; }
QToolTip { background: #FFFFFF; color: #2B2E33; border: 1px solid #D3D6DB; padding: 4px; }

/* application bar */
#AppBar { background: #FFFFFF; border-bottom: 1px solid #D3D6DB; }
#AppBar QToolButton { border: none; padding: 3px; border-radius: 3px; }
#AppBar QToolButton:hover { background: #E8EEF4; }
#DocumentTab { color: #2B2E33; font-weight: 600; padding: 2px 10px; border-left: 1px solid #D3D6DB; border-right: 1px solid #D3D6DB; background: #F7F7F8; }

/* workspace switcher + ribbon */
#RibbonRow { background: #F7F7F8; border-bottom: 1px solid #D3D6DB; }
#WorkspaceSwitcher { font-weight: 700; color: #2B2E33; border: 1px solid #D3D6DB; border-radius: 3px; padding: 4px 8px; background: #FFFFFF; margin: 4px; }
#WorkspaceSwitcher:hover { border-color: #0696D7; }
#RibbonTabs QTabBar::tab { background: transparent; color: #6B7079; padding: 4px 12px; border: none; border-bottom: 2px solid transparent; font-weight: 600; font-size: 8pt; }
#RibbonTabs QTabBar::tab:selected { color: #2B2E33; border-bottom: 2px solid #0696D7; }
#RibbonTabs QTabBar::tab:hover { color: #2B2E33; }
#RibbonGroup { border-right: 1px solid #E1E4E8; }
QToolButton#RibbonTool { border: 1px solid transparent; border-radius: 3px; padding: 2px; background: transparent; }
QToolButton#RibbonTool:hover { background: #E8EEF4; border-color: #C9D7E6; }
QToolButton#RibbonTool:pressed, QToolButton#RibbonTool:checked { background: #D3E6F5; }
QToolButton#RibbonTool:disabled { color: #A9AEB5; }
QToolButton#RibbonGroupLabel { border: none; color: #2B2E33; font-size: 7.5pt; font-weight: 600; padding: 0 4px 2px 4px; }
QToolButton#RibbonGroupLabel:hover { color: #0696D7; }
QToolButton#RibbonGroupLabel::menu-indicator { subcontrol-position: right center; }
QToolButton#FinishSketchButton { background: #3BA55C; color: white; font-weight: 700; border-radius: 3px; padding: 4px 10px; border: none; }
QToolButton#FinishSketchButton:hover { background: #33914F; }

QMenu { background: #FFFFFF; border: 1px solid #D3D6DB; padding: 4px 0; }
QMenu::item { padding: 4px 28px 4px 26px; }
QMenu::item:selected { background: #E3F1FA; color: #2B2E33; }
QMenu::item:disabled { color: #A9AEB5; }
QMenu::separator { height: 1px; background: #E1E4E8; margin: 4px 8px; }

/* browser */
QDockWidget { color: #2B2E33; font-weight: 600; }
QDockWidget::title { background: #F7F7F8; padding: 4px 8px; border-bottom: 1px solid #D3D6DB; }
QTreeWidget#Browser { background: #FFFFFF; border: none; }
QListWidget { background: #FFFFFF; color: #2B2E33; border: none; }
QListWidget::item:selected { background: #D3E6F5; color: #2B2E33; }
QTreeWidget#Browser { color: #2B2E33; }
QTreeWidget#Browser::item { padding: 2px 0; color: #2B2E33; }
QTreeWidget#Browser::item:hover { background: #EEF5FB; }
QTreeWidget#Browser::item:selected { background: #D3E6F5; color: #2B2E33; }

/* timeline */
#Timeline { background: #F7F7F8; border-top: 1px solid #D3D6DB; }
#Timeline QToolButton { border: none; padding: 2px; border-radius: 3px; }
#Timeline QToolButton:hover { background: #E8EEF4; }

/* command dialog */
#CommandDialog { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 4px; }
#CommandDialogTitle { background: #F7F7F8; border-bottom: 1px solid #D3D6DB; border-top-left-radius: 4px; border-top-right-radius: 4px; }
#CommandDialogTitle QLabel { font-weight: 700; color: #2B2E33; }
#CommandDialogMessage { color: #6B7079; }
#CommandDialogMessage[error="true"] { color: #D93025; }
QPushButton { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 3px; padding: 4px 14px; color: #2B2E33; }
QPushButton:hover { border-color: #0696D7; }
QPushButton#OkButton, QPushButton:default { background: #0696D7; border-color: #0696D7; color: #FFFFFF; font-weight: 600; }
QPushButton#OkButton:disabled { background: #9CCDE6; border-color: #9CCDE6; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 3px; padding: 2px 4px; selection-background-color: #0696D7; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #0696D7; }
QLineEdit[invalid="true"] { border-color: #D93025; background: #FFF4F3; }
QToolButton#SelectionInput { border: 1px solid #C3C8CF; border-radius: 3px; padding: 2px 6px; background: #FFFFFF; text-align: left; }
QToolButton#SelectionInput:checked { border-color: #0696D7; background: #E3F1FA; }

/* viewport overlays */
#NavBar { background: rgba(255,255,255,230); border: 1px solid #D3D6DB; border-radius: 4px; }
#NavBar QToolButton { border: none; padding: 3px; border-radius: 3px; }
#NavBar QToolButton:hover { background: #E8EEF4; }
#NavBar QToolButton:checked { background: #D3E6F5; }

/* S-box */
#SearchPopup { background: #FFFFFF; border: 1px solid #C3C8CF; border-radius: 4px; }
#SearchPopup QTreeWidget { border: none; }
#SearchPopup QTreeWidget::item:selected { background: #E3F1FA; color: #2B2E33; }

/* status bar / command line */
QStatusBar { background: #F7F7F8; border-top: 1px solid #D3D6DB; color: #2B2E33; }
QStatusBar QLabel { color: #2B2E33; padding: 0 6px; }
#StatusPrompt { color: #2B2E33; }
#StatusDim { color: #6B7079; }
#CommandLine { font-family: monospace; min-width: 260px; }
