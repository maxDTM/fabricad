    <binary>fabricad</binary>
    <mediatype>application/x-fabricad</mediatype>
  </provides>
  <releases>
    <release version="0.2.0" date="2026-10-24"/>
    <release version="0.1.0" date="2026-10-23"/>
  </releases>
  <content_rating type="oars-1.1"/>
